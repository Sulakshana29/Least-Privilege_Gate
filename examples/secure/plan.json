          "mode": "managed",
          "type": "aws_iam_policy",
          "name": "app_s3_policy",
          "provider_name": "registry.terraform.io/hashicorp/aws",
          "schema_version": 0,
          "values": {
            "name": "my-app-s3-access",
            "description": "Allows the application to read and write to its document bucket only",
            "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"S3ObjectAccess\",\"Effect\":\"Allow\",\"Action\":[\"s3:GetObject\",\"s3:PutObject\",\"s3:DeleteObject\"],\"Resource\":\"arn:aws:s3:::my-app-documents/my-app/*\"},{\"Sid\":\"S3ListBucket\",\"Effect\":\"Allow\",\"Action\":[\"s3:ListBucket\"],\"Resource\":\"arn:aws:s3:::my-app-documents\",\"Condition\":{\"StringLike\":{\"s3:prefix\":[\"my-app/*\"]}}}]}"
          }
        },
        {
          "address": "aws_iam_policy.app_kms_policy",
          "mode": "managed",
          "type": "aws_iam_policy",
          "name": "app_kms_policy",
          "provider_name": "registry.terraform.io/hashicorp/aws",
          "schema_version": 0,
          "values": {
            "name": "my-app-kms-access",
            "description": "Allows the application to use a specific KMS key for encryption",
            "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"KMSEncryptDecrypt\",\"Effect\":\"Allow\",\"Action\":[\"kms:Decrypt\",\"kms:GenerateDataKey\"],\"Resource\":\"arn:aws:kms:us-east-1:123456789012:key/mrk-1234abcd12ab34cd56ef1234567890ab\"}]}"
          }
        },
        {
